{
  "name": "minecraft-custom-launcher",
  "version": "1.0.0",
  "description": "Un launcher Minecraft custom inspiré d'Essential",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.minecraft.customlauncher",
    "productName": "Minecraft Custom Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "index.html",
      "assets/**/*"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0"
  }
}